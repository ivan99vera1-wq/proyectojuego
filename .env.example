# ---- Servidor de juego ----
GAME_SERVER_PORT=2567
GAME_SERVER_HOST=0.0.0.0
# Secreto para firmar tokens de sesión (cámbialo en producción)
AUTH_JWT_SECRET=change-me
# Persistencia: "memory" (por defecto) | "sqlite" | "postgres"
PERSISTENCE_DRIVER=memory
DATABASE_URL=

# ---- Cliente ----
# URL pública del servidor a la que conecta el navegador
VITE_GAME_SERVER_URL=ws://localhost:2567

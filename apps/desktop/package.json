{
  "name": "@game/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cáscara de escritorio (Electron) para lanzar el juego en Windows/macOS/Linux y, en el futuro, Steam.",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "npm run compile && electron .",
    "compile": "tsx ../../tools/export-branding.ts && tsc -p tsconfig.json",
    "build": "npm run compile && electron-builder --config electron-builder.config.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  }
}

{
  "name": "game-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo del juego (el nombre p\u00fablico vive en packages/config/src/branding.ts)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n servidor,cliente -c cyan,magenta -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev -w @game/client",
    "dev:server": "npm run dev -w @game/server",
    "dev:desktop": "npm run dev -w @game/desktop",
    "build": "npm run build -w @game/config -w @game/shared && npm run build -w @game/client -w @game/server",
    "build:desktop": "npm run build && npm run build -w @game/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:map": "tsx tools/check-map.ts",
    "check:rig": "node tools/check-bone-axes.mjs",
    "assets:maps": "tsx tools/export-map-layouts.ts",
    "assets:optimize": "node tools/optimize-assets.mjs",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0"
  }
}

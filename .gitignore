node_modules/
dist/
build/
out/
release/
*.log
.env
.env.local
.DS_Store
coverage/
.vite/
# Assets procesados pesados se generan con tools/; los fuentes viven en assets/source
apps/client/public/assets/**/*.ktx2

# Blender: caché de bytecode de Python
__pycache__/
*.pyc

# Modelo base de Sketchfab: se versiona el .blend, que es el que lee el
# pipeline. El resto son exportaciones del MISMO modelo (y .blend1 es la copia
# de seguridad que deja Blender), así que no aportan nada al repositorio.
assets/source/*.blend1
# Copias de seguridad que deja Blender al guardar, en cualquier carpeta
*.blend1
assets/source/*.fbx
assets/source/*.obj
assets/source/*.mtl
assets/source/*.stl

# Packs de assets de terceros: se versiona SOLO el glTF/GLB que usa este motor
# (3,7 MB). Los mismos modelos vienen repetidos en fbx, obj y proyectos de
# Unity/Unreal que aquí no sirven para nada, y suman 180 MB.
assets/source/**/fbx/
assets/source/**/fbx(unity)/
assets/source/**/obj/
assets/source/**/Unity/
assets/source/**/FBX format/
assets/source/**/OBJ format/
assets/source/**/FBX (Unreal Engine)/
assets/source/**/Previews/
assets/source/**/Samples/
assets/source/**/Preview.png
assets/source/**/contents.png
assets/source/**/*.url
assets/source/**/Overview.html
